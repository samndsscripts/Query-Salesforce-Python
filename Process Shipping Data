def get_latest_csv(path):
    files = [f for f in os.listdir(path) if f.endswith(".csv")]
    if not files:
        print("No CSV files found.")
        return None
    files = [os.path.join(path, f) for f in files]
    return max(files, key=os.path.getmtime)

def clean_val(val):
    """Normalize string/numeric values consistently"""
    if pd.isna(val):
        return ''
    val = str(val).replace('\xa0','').replace('\t','').strip().upper()
    # If numeric, convert floats that are whole numbers to int strings
    try:
        f = float(val)
        if f.is_integer():
            val = str(int(f))
    except:
        pass
    return val

def generate_ident(row):
    return (
        clean_val(row.get("Sales Order")) + '|' +
        clean_val(row.get("Stock Code")) + '|' +
        clean_val(row.get("Mfg Plant Name")) + '|' +
        clean_val(row.get("Order Qty")) + '|' +
        clean_val(row.get("Ship Year")) + '|' +
        clean_val(row.get("Ship Month"))
    )



def process_csv():
    csv_file = get_latest_csv(DOWNLOAD_DIR)
    if not csv_file:
        return

    file_timestamp = datetime.fromtimestamp(os.path.getmtime(csv_file)).strftime("%Y-%m-%d %H:%M:%S")
    print(f"\nProcessing: {csv_file} (Last modified: {file_timestamp})")

    # ------------------ Load CSV ------------------ #
    df = pd.read_csv(csv_file)
    df.columns = df.columns.str.strip()  # Remove spaces

    # ------------------ Keep required columns ------------------ #
    required_columns = [
    "Sales Order",
    "Month, Day, Year of Req Ship Date",  # new date column
    "Category",
    "Stock Code",
    "Mfg Plant Name",
    "Order Qty"
    ]

    df = df[[col for col in required_columns if col in df.columns]].copy()

    # ------------------ Clean & Standardize ------------------ #
    df["Sales Order"] = df["Sales Order"].fillna('').astype(str).str.lstrip("0").str.strip().str.upper()
    df["Stock Code"] = df["Stock Code"].astype(str).str.strip().str.upper()
    df["Mfg Plant Name"] = df["Mfg Plant Name"].astype(str).str.strip().str.upper()
    df["Order Qty"] = pd.to_numeric(df["Order Qty"], errors="coerce").fillna(0).astype(int)
    df["Category"] = df["Category"].astype(str).str.strip()

    # ------------------ Convert Ship Date to Year/Month & formatted string ------------------ #
    df['Ship Date'] = pd.to_datetime(df['Month, Day, Year of Req Ship Date'], errors='coerce')
    df['Ship Year'] = df['Ship Date'].dt.year
    df['Ship Month'] = df['Ship Date'].dt.month
    df['Ship Date Formatted'] = df['Ship Date'].dt.strftime('%m/%d/%Y')


    # ------------------ Keep only valid Sales Orders ------------------ #
    df = df[df["Sales Order"].astype(str).str.strip() != ""]

    if df.empty:
        print("No valid rows found in CSV.")
        return

    # ------------------ Generate Ident ------------------ #
    df['Ident'] = df.apply(generate_ident, axis=1)

    # ------------------ Read existing Excel Ident ------------------ #
    table_range = table.range
    if table_range and table_range.value:
        header = table_range.value[0]
        body = table_range.value[1:] if len(table_range.value) > 1 else []
        excel_df = pd.DataFrame(body, columns=header)
        excel_df = excel_df.fillna('')
        existing_ident_list = [str(i).replace('\xa0','').strip() for i in excel_df['Ident'].astype(str).tolist()] if 'Ident' in excel_df.columns else []
    else:
        existing_ident_list = []

    # ------------------ Filter new rows ------------------ #
    new_rows = df[~df["Ident"].isin(existing_ident_list)]
    if new_rows.empty:
        print("No new rows to append after filtering existing Idents.")
        return

    # ------------------ Prepare final DataFrame ------------------ #
    new_rows['TimeStamp'] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    # Rename columns to match Excel output
    new_rows = new_rows.rename(columns={
        "Sales Order": "Sales Order #",
        "Ship Date Formatted": "Date Shipped",
        "Ship Year": "Year",
        "Ship Month": "Month"
    })


    # Reorder columns exactly as needed
    df_final = new_rows[[
    'Ident',
    'Sales Order #',
    'Date Shipped',  # formatted MM/DD/YYYY
    'Year',          # numeric
    'Month',         # numeric
    'Category',
    'Stock Code',
    'Mfg Plant Name',
    'Order Qty',
    'TimeStamp'
    ]]

    # Convert to string and prepare for Excel
    data_to_write = df_final.fillna('').astype(str).values.tolist()

    # Determine first row to write
    if table.data_body_range:
        first_row = table.data_body_range.last_cell.row + 1
    else:
        first_row = table.range.row + 1
    start_col = table.range.column

    # ------------------ Write in batches ------------------ #
    batch_size = 50000
    for i in range(0, len(data_to_write), batch_size):
        batch = data_to_write[i:i + batch_size]

        # Debug print
        for row in batch:
            print(f"Order Number: {row[1]}  |  Ident: {row[0]}")

        sheet.range((first_row + i, start_col)).value = batch
        print(f"Wrote rows {first_row + i} to {first_row + i + len(batch) - 1}")

    print(f"{len(data_to_write)} new rows appended to Excel.")

    # ------------------ Archive CSV ------------------ #
    processed_dir = os.path.join(DOWNLOAD_DIR, "processed")
    os.makedirs(processed_dir, exist_ok=True)
    zip_filename = os.path.join(
        processed_dir,
        f"{os.path.basename(csv_file).replace('.csv','')}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.zip"
    )
    with zipfile.ZipFile(zip_filename, "w", zipfile.ZIP_DEFLATED) as zipf:
        zipf.write(csv_file, os.path.basename(csv_file))
    os.remove(csv_file)
    print(f"Archived and removed CSV: {zip_filename}")

if __name__ == "__main__":
    process_csv()
