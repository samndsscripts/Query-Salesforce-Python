        "Stock Code", shipment_data[Stock Code],
        "RMA Value", BLANK(),
        "Shipping Whse", BLANK(),
        "Case Number", BLANK(),
        "Comments", BLANK(),
        "Account Name", BLANK()
    ),

    SELECTCOLUMNS(
        Log1,
        "Source", "LITHIA SPRINGS",
        "Category", Log1[Category],
        "Bought Out", "Made In",
        "Quantity", INT(Log1[Quantity]),
        "Date", DATEVALUE(Log1[Date]),
        "Type", "Log",
        "Case Reason", Log1[General Concern],
        "Stock Code", Log1[Part Number],
        "RMA Value", BLANK(),
        "Shipping Whse", BLANK(),
        "Case Number", BLANK(),
        "Comments", BLANK(),
        "Account Name", BLANK()
    )
)
