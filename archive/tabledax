Fact_All = 
UNION(
    SELECTCOLUMNS(
        RMA_Raw,
        "Source", RMA_Raw[Source],
        "Category", RMA_Raw[Category],
        "Bought Out", IF(VALUE(RMA_Raw[Bought Part]) = 1, "Bought Out", "Made In"),
        "Quantity", INT(RMA_Raw[Quantity]),
        "Date", DATEVALUE(RMA_Raw[Opened Date]),
        "Type", "RMA",
        "Case Reason", RMA_Raw[Case Reason],
        "Stock Code", RMA_Raw[Stock Code],
        "RMA Value", RMA_Raw[RMA Value],
        "Shipping Whse", RMA_Raw[Shipping Whse],
        "Case Number", RMA_Raw[Case Number],
        "Comments", RMA_Raw[Comments],
        "Account Name", RMA_Raw[Account Name]
    ),

    SELECTCOLUMNS(
        shipment_data,
        "Source", shipment_data[Source],
        "Category", shipment_data[Category],
        "Bought Out", IF(VALUE(shipment_data[Bought Out]) = 1, "Bought Out", "Made In"),
        "Quantity", INT(shipment_data[Order Qty]),
        "Date", DATEVALUE(shipment_data[Date Shipped]),
        "Type", "Shipment",
