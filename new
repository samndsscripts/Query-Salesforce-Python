# --- Helpers ---
def clear_console():
    os.system('cls' if os.name == 'nt' else 'clear')

def parse_case_number(x):
    try:
        return int(float(str(x).strip()))
    except:
        return None

def normalize(text):
    t = str(text or '').lower()
    t = re.sub(r"[^a-z0-9\s]", " ", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t

def extract_quantity(title):
    """Extract quantity from case title (subject line)."""
    if not title:
        return None
    text = title.lower()
    matches = re.findall(r'(?:qty\s*[:\-]?\s*(\d+))|(?:(\d+)\s*pcs?)', text)
    total_qty = 0
    for m in matches:
        num = next((int(x) for x in m if x and x.isdigit()), None)
        if num:
            total_qty += num
    return total_qty if total_qty > 0 else None
# --- Helper: Get latest shipment source for a stock code ---
def get_latest_source_for_stock_code(matched_stock_code):
    """
    Given a matched stock code, find the most recent shipment in ship_df
    and return (source, bought_out, category).
    """
    mask = ship_df['Stock Code'].astype(str).str.strip().str.lower() == matched_stock_code.strip().lower()
    matched_rows = ship_df[mask].copy()
    
    if matched_rows.empty:
        return "N/A", "", "Unidentified"
    
    matched_rows['_parsed_date'] = pd.to_datetime(matched_rows['Date Shipped'], errors='coerce')
    matched_rows = matched_rows.sort_values('_parsed_date', ascending=False)
    
    latest = matched_rows.iloc[0]
    
    source = str(latest['Source']).strip() if pd.notna(latest['Source']) else "N/A"
    
    # Convert boolean/numeric back to "TRUE"/"FALSE" string
    raw_bought_out = latest['Bought Out']
    if raw_bought_out in [1, 1.0, True, '1', 'TRUE', 'True', 'true']:
        bought_out = "TRUE"
    elif raw_bought_out in [0, 0.0, False, '0', 'FALSE', 'False', 'false']:
        bought_out = "FALSE"
    else:
        bought_out = ""  # Empty if unexpected value
    
    category = str(latest['Category']).strip() if pd.notna(latest['Category']) else "Unidentified"
    
    if not source or source == 'nan':
        source = "N/A"
    if not category or category == 'nan':
        category = "Unidentified"
    
    return source, bought_out, category

# --- Determine Source (optimized single-call fuzzy match) ---
def determine_source(description, fuzzy_threshold=70, exact_threshold=90):
    """
    Matches description to stock codes via fuzzy matching.
    Uses single extractOne call against all codes for performance.
    Returns: (source, top_match_string, bought_out)
    """
    nd = normalize(description)
    if not nd:
        return "N/A", "", None

    # Single call against entire list - much faster than looping
    best_match = process.extractOne(nd, normalized_stock_codes, score_cutoff=fuzzy_threshold)
    
    if best_match:
        matched_norm_code, score, idx = best_match
        stock_code = stock_codes_list[idx]
        source, bought_out, category = get_latest_source_for_stock_code(stock_code)
        top_match = f"Stock Code: {stock_code} | Source: {source}"
        return source, top_match, bought_out

    return "N/A", "", None


# --- Determine Source from Comments (optimized single-call fuzzy match) ---
def determine_source_from_comments(comment_text, exact_threshold=90):
    """
    Determines the source from comment text via stock code matching.
    Uses single extractOne call against all codes for performance.
    Returns: (source, top_match_string, bought_out)
    """
    nd = normalize(comment_text)
    if not nd:
        return "N/A", "", None

    # Single call against entire list
    best_match = process.extractOne(nd, normalized_stock_codes, score_cutoff=exact_threshold)
    
    if best_match:
        matched_norm_code, score, idx = best_match
        stock_code = stock_codes_list[idx]
        source, bought_out, category = get_latest_source_for_stock_code(stock_code)
        top_match = f"Stock Code: {stock_code} | Source: {source}"
        return source, top_match, bought_out

    return "N/A", "", None


